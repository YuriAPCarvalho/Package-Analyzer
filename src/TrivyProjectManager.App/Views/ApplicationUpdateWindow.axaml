<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TrivyProjectManager.App.Views.ApplicationUpdateWindow"
        Width="620"
        Height="430"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Icon="/Assets/app-icon.ico"
        Title="Atualização obrigatória">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="14">
    <StackPanel Spacing="5">
      <TextBlock Text="Atualização obrigatória" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.82" />
      <TextBlock Text="{Binding VersionText}" TextWrapping="Wrap" Opacity="0.74" />
    </StackPanel>

    <Border Grid.Row="1"
            Padding="12"
            CornerRadius="6"
            Background="{DynamicResource SystemControlBackgroundChromeLowBrush}">
      <ScrollViewer>
        <TextBlock Text="{Binding ReleaseNotes}"
                   TextWrapping="Wrap"
                   FontFamily="Consolas" />
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Fechar aplicação" Click="CloseApplication_Click" />
      <Button Content="Atualizar agora" Click="UpdateNow_Click" />
    </StackPanel>
  </Grid>
</Window>
