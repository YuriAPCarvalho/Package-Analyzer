<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TrivyProjectManager.App.Views.MessageWindow"
        Width="520"
        Height="220"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{Binding TitleText}">
  <Grid RowDefinitions="*,Auto" Margin="20">
    <TextBlock Text="{Binding Message}"
               TextWrapping="Wrap"
               VerticalAlignment="Center"
               FontSize="15" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancelar" IsVisible="{Binding ShowCancel}" Click="Cancel_Click" />
      <Button Content="OK" Click="Ok_Click" />
    </StackPanel>
  </Grid>
</Window>
