<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TrivyProjectManager.App.Views.MainWindow"
        Title="{Binding AppTitle}"
        Icon="/Assets/app-icon.ico"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="640"
        Background="#000000">
  <Grid ColumnDefinitions="300,*" Background="#000000">
    <Border Padding="16" Background="#070A0F">
      <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Margin="0,0,0,14">
          <TextBlock Text="{Binding AppTitle}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="Gerencie scans locais por projeto." FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Row="1" Content="Adicionar projeto" Command="{Binding AddProjectCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,12" />
        <ListBox Grid.Row="2" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Padding="10" Margin="0,0,0,8" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Technology}" FontSize="12" Opacity="0.8" />
                  <TextBlock Text="{Binding Path}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding LastScan, StringFormat='Última execução: {0}'}" FontSize="11" />
                  <TextBlock Text="{Binding LastStatus, StringFormat='Status: {0}'}" FontSize="11" />
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <TextBlock Text="{Binding Critical, StringFormat='Crítica {0}'}" Foreground="#D13438" />
                    <TextBlock Text="{Binding High, StringFormat='Alta {0}'}" Foreground="#F7630C" />
                    <TextBlock Text="{Binding Medium, StringFormat='Média {0}'}" Foreground="#CA5010" />
                    <TextBlock Text="{Binding Low, StringFormat='Baixa {0}'}" Foreground="#107C10" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="18">
      <Border Padding="14" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
          <StackPanel>
            <TextBlock Text="{Binding SelectedProject.Name, FallbackValue='Selecione ou cadastre um projeto'}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ProgressText}" Opacity="0.78" />
          </StackPanel>
          <Button Grid.Column="1" Content="Scan rápido" Command="{Binding RunQuickScanCommand}" />
          <Button Grid.Column="2" Content="Scan completo" Command="{Binding RunFullScanCommand}" />
          <Button Grid.Column="3" Content="Cancelar" Command="{Binding CancelScanCommand}" IsEnabled="{Binding IsScanRunning}" />
        </Grid>
      </Border>

      <TabControl Grid.Row="1" Margin="0,14,0,0">
        <TabItem Header="Resumo">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="0,8,0,0">
              <StackPanel Spacing="3">
                <TextBlock Text="Resumo" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Visão geral do último scan concluído, com severidades, ocorrências e evolução dos achados." Opacity="0.74" TextWrapping="Wrap" />
              </StackPanel>
              <UniformGrid Columns="6">
                <Border Margin="0,0,8,8" Padding="12" CornerRadius="6" Background="#3B1113"><StackPanel><TextBlock Text="Crítica" /><TextBlock Text="{Binding CriticalCount}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                <Border Margin="0,0,8,8" Padding="12" CornerRadius="6" Background="#4A2408"><StackPanel><TextBlock Text="Alta" /><TextBlock Text="{Binding HighCount}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                <Border Margin="0,0,8,8" Padding="12" CornerRadius="6" Background="#40320A"><StackPanel><TextBlock Text="Média" /><TextBlock Text="{Binding MediumCount}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                <Border Margin="0,0,8,8" Padding="12" CornerRadius="6" Background="#12351E"><StackPanel><TextBlock Text="Baixa" /><TextBlock Text="{Binding LowCount}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                <Border Margin="0,0,8,8" Padding="12" CornerRadius="6" Background="#252525"><StackPanel><TextBlock Text="Desconhecida" /><TextBlock Text="{Binding UnknownCount}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                <Border Margin="0,0,8,8" Padding="12" CornerRadius="6" Background="#1E2C3A"><StackPanel><TextBlock Text="Ocorrências" /><TextBlock Text="{Binding OccurrenceCount}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
              </UniformGrid>
              <UniformGrid Columns="6">
                <Border Margin="0,0,8,8" Padding="12" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"><StackPanel><TextBlock Text="Vulnerabilidades únicas" /><TextBlock Text="{Binding UniqueVulnerabilityCount}" FontSize="22" /></StackPanel></Border>
                <Border Margin="0,0,8,8" Padding="12" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"><StackPanel><TextBlock Text="Configurações incorretas" /><TextBlock Text="{Binding MisconfigurationCount}" FontSize="22" /></StackPanel></Border>
                <Border Margin="0,0,8,8" Padding="12" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"><StackPanel><TextBlock Text="Segredos" /><TextBlock Text="{Binding SecretCount}" FontSize="22" /></StackPanel></Border>
                <Border Margin="0,0,8,8" Padding="12" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"><StackPanel><TextBlock Text="Novas" /><TextBlock Text="{Binding NewCount}" FontSize="22" /></StackPanel></Border>
                <Border Margin="0,0,8,8" Padding="12" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"><StackPanel><TextBlock Text="Resolvidas" /><TextBlock Text="{Binding ResolvedCount}" FontSize="22" /></StackPanel></Border>
                <Border Margin="0,0,8,8" Padding="12" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"><StackPanel><TextBlock Text="Regressões" /><TextBlock Text="{Binding RegressionCount}" FontSize="22" /></StackPanel></Border>
              </UniformGrid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Vulnerabilidades">
          <Grid RowDefinitions="Auto,Auto,*" Margin="0,8,0,0">
            <StackPanel Spacing="3">
              <TextBlock Text="Vulnerabilidades" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="Lista os pacotes e identificadores CVE/GHSA encontrados, com severidade, status, versão instalada, correção e targets afetados." Opacity="0.74" TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,4">
              <ComboBox Width="150" ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding SelectedSeverity}" Margin="0,0,8,8" />
              <ComboBox Width="150" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Margin="0,0,8,8" />
              <ComboBox Width="150" ItemsSource="{Binding DependencyOptions}" SelectedItem="{Binding SelectedDependency}" Margin="0,0,8,8" />
              <TextBox Width="210" PlaceholderText="Busca" Text="{Binding SearchFilter}" Margin="0,0,8,8" />
              <TextBox Width="170" PlaceholderText="Pacote" Text="{Binding PackageFilter}" Margin="0,0,8,8" />
              <TextBox Width="150" PlaceholderText="CVE/GHSA" Text="{Binding IdFilter}" Margin="0,0,8,8" />
              <TextBox Width="170" PlaceholderText="Target" Text="{Binding TargetFilter}" Margin="0,0,8,8" />
              <CheckBox Content="Possui correção" IsChecked="{Binding OnlyWithFix}" Margin="0,3,8,8" />
            </WrapPanel>
            <Grid Grid.Row="2">
              <TextBlock Text="Nenhuma vulnerabilidade encontrada para os filtros atuais." IsVisible="{Binding HasNoFindings}" Margin="0,16,0,0" Opacity="0.72" />
              <ScrollViewer IsVisible="{Binding HasFindings}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel MinWidth="1180">
                  <Border Padding="10,8" CornerRadius="6,6,0,0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                    <Grid ColumnDefinitions="220,155,95,110,115,120,130,75" ColumnSpacing="12">
                      <TextBlock Text="Pacote" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="CVE/GHSA" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Text="Risco" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="3" Text="Situação" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="4" Text="Correção" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="5" Text="Instalada" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="6" Text="Recomendada" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="7" Text="Ocorr." FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Findings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Expander Margin="0,0,0,1" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                          <Expander.Header>
                            <Grid ColumnDefinitions="220,155,95,110,115,120,130,75" ColumnSpacing="12" MinHeight="34">
                              <StackPanel Spacing="1">
                                <TextBlock Text="{Binding Package}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Package}" />
                                <TextBlock Text="{Binding Title}" FontSize="11" Opacity="0.68" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="{Binding Vulnerability}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Vulnerability}" />
                              <Border Grid.Column="2" Padding="8,3" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Severity}" />
                              </Border>
                              <Border Grid.Column="3" Padding="8,3" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Status}" />
                              </Border>
                              <Border Grid.Column="4" Padding="8,3" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding FixStatus}" />
                              </Border>
                              <TextBlock Grid.Column="5" Text="{Binding InstalledVersion}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding InstalledVersion}" />
                              <TextBlock Grid.Column="6" Text="{Binding RecommendedFixedVersion}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FixedVersion}" />
                              <TextBlock Grid.Column="7" Text="{Binding Occurrences}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                          </Expander.Header>
                          <Border Width="1180" Padding="14" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" BorderThickness="0,1,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                              <StackPanel Spacing="12">
                                <Border Padding="10" Background="#33231D" IsVisible="{Binding HasRuntimeSupportAlert}">
                                  <TextBlock Text="{Binding RuntimeSupportAlert}" TextWrapping="Wrap" />
                                </Border>
                                <Grid Width="1152" ColumnDefinitions="680,456" ColumnSpacing="16">
                                  <StackPanel Spacing="4">
                                    <TextBlock Text="Descrição" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Resumo técnico" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Type, StringFormat='Tipo: {0}'}" />
                                    <TextBlock Text="{Binding Package, StringFormat='Pacote: {0}'}" />
                                    <TextBlock Text="{Binding Ecosystem, StringFormat='Ecossistema: {0}'}" />
                                    <TextBlock Text="{Binding DependencyRelation, StringFormat='Origem: {0}'}" />
                                    <TextBlock Text="{Binding Severity, StringFormat='Risco: {0}'}" />
                                    <TextBlock Text="{Binding Status, StringFormat='Situação no projeto: {0}'}" />
                                    <TextBlock Text="{Binding FixStatus, StringFormat='Correção: {0}'}" />
                                    <TextBlock Text="{Binding Cvss, StringFormat='CVSS: {0}'}" />
                                    <TextBlock Text="{Binding CvssVector, StringFormat='Vetor: {0}'}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Cwe, StringFormat='CWE: {0}'}" />
                                    <TextBlock Text="{Binding SeveritySource, StringFormat='Fonte da severidade: {0}'}" />
                                    <TextBlock Text="{Binding OccurrenceSummary}" />
                                    <TextBlock Text="{Binding PublishedDate, StringFormat='Primeira detecção/fonte: {0}'}" />
                                    <TextBlock Text="{Binding LastModifiedDate, StringFormat='Última modificacao/fonte: {0}'}" />
                                  </StackPanel>
                                </Grid>
                                <Grid Width="1152" ColumnDefinitions="360,776" ColumnSpacing="16">
                                  <StackPanel Spacing="3">
                                    <TextBlock Text="Versões" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding InstalledVersion, StringFormat='Instalada: {0}'}" />
                                    <TextBlock Text="{Binding RecommendedFixedVersion, StringFormat='Atualização recomendada: {0}'}" />
                                    <TextBlock Text="{Binding OtherFixedVersions, StringFormat='Outras linhas corrigidas: {0}'}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DependencyGuidance}" TextWrapping="Wrap" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Target afetado" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding OccurrenceList}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <Grid ColumnDefinitions="170,*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding RelativePath}" FontFamily="Consolas" TextWrapping="Wrap" ToolTip.Tip="{Binding AbsolutePath}" />
                                            <Button Grid.Column="2" Content="Copiar caminho" Command="{Binding $parent[Window].DataContext.CopyPathCommand}" CommandParameter="{Binding}" />
                                            <Button Grid.Column="3" Content="Abrir pasta" Command="{Binding $parent[Window].DataContext.OpenFolderCommand}" CommandParameter="{Binding}" />
                                          </Grid>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding MaskedSnippet}" TextWrapping="Wrap" FontFamily="Consolas" />
                                  </StackPanel>
                                </Grid>
                                <StackPanel Width="1152" Spacing="4" IsVisible="{Binding HasReferences}">
                                  <TextBlock Text="Referências" FontWeight="SemiBold" />
                                  <ItemsControl ItemsSource="{Binding ReferencesList}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <Button Content="{Binding Label}" HorizontalAlignment="Left" Command="{Binding $parent[Window].DataContext.OpenReferenceCommand}" CommandParameter="{Binding Url}" />
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                                <TextBlock Text="{Binding UpdateCommand, StringFormat='Comando sugerido: {0}'}" TextWrapping="Wrap" FontFamily="Consolas" IsVisible="{Binding HasUpdateCommand}" />
                                <TextBlock Text="A atualização pode causar breaking changes. Execute um novo scan depois de atualizar para confirmar a correção." TextWrapping="Wrap" IsVisible="{Binding HasUpdateCommand}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <Button Content="Abrir referência" Command="{Binding $parent[Window].DataContext.OpenUrlCommand}" CommandParameter="{Binding}" IsVisible="{Binding HasPrimaryUrl}" />
                                  <Button Content="Copiar CVE" Command="{Binding $parent[Window].DataContext.CopyCveCommand}" CommandParameter="{Binding}" />
                                  <Button Content="Copiar detalhes" Command="{Binding $parent[Window].DataContext.CopyDetailsCommand}" CommandParameter="{Binding}" />
                                  <Button Content="Copiar atualização" Command="{Binding $parent[Window].DataContext.CopyUpdateCommandCommand}" CommandParameter="{Binding}" IsVisible="{Binding HasUpdateCommand}" />
                                  <Button Content="Criar exceção" Command="{Binding $parent[Window].DataContext.CreateExceptionCommand}" CommandParameter="{Binding}" />
                                  <Button Content="Recolher detalhes" Command="{Binding CollapseCommand}" />
                                </StackPanel>
                              </StackPanel>
                            </ScrollViewer>
                          </Border>
                        </Expander>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="Configurações incorretas">
          <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
            <StackPanel Spacing="3">
              <TextBlock Text="Configurações incorretas" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="Mostra falhas de configuração detectadas pelo Trivy em arquivos como Dockerfile, manifests e infraestrutura como código." Opacity="0.74" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,12,0,0">
              <TextBlock Text="Nenhuma configuração incorreta encontrada no último scan." IsVisible="{Binding HasNoMisconfigurationFindings}" Opacity="0.72" />
              <ScrollViewer IsVisible="{Binding HasMisconfigurationFindings}">
                <ItemsControl ItemsSource="{Binding MisconfigurationFindings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="10" Margin="0,0,0,8" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Vulnerability}" FontWeight="SemiBold" />
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding Severity, StringFormat='Severidade: {0}'}" />
                            <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" />
                          </StackPanel>
                          <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Target, StringFormat='Target: {0}'}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding MaskedSnippet}" FontFamily="Consolas" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="Segredos">
          <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
            <StackPanel Spacing="3">
              <TextBlock Text="Segredos" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="Apresenta possíveis tokens, chaves e credenciais detectados. O conteúdo sensível é sempre mascarado antes de aparecer ou ser persistido." Opacity="0.74" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,12,0,0">
              <TextBlock Text="Nenhum segredo encontrado no último scan." IsVisible="{Binding HasNoSecretFindings}" Opacity="0.72" />
              <ScrollViewer IsVisible="{Binding HasSecretFindings}">
                <ItemsControl ItemsSource="{Binding SecretFindings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="10" Margin="0,0,0,8" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Vulnerability}" FontWeight="SemiBold" />
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding Severity, StringFormat='Severidade: {0}'}" />
                            <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" />
                          </StackPanel>
                          <TextBlock Text="{Binding Target, StringFormat='Local: {0}'}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding MaskedSnippet}" FontFamily="Consolas" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="Histórico">
          <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
            <StackPanel Spacing="3">
              <TextBlock Text="Histórico" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="Lista execuções anteriores do projeto selecionado para acompanhar duração, status, versão do Trivy e mudanças entre scans." Opacity="0.74" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,12,0,0">
              <TextBlock Text="Nenhuma execução registrada para este projeto." IsVisible="{Binding HasNoScans}" Opacity="0.72" />
              <ScrollViewer IsVisible="{Binding HasScans}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel MinWidth="1080">
                  <Border Padding="10,8" CornerRadius="6,6,0,0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                    <Grid ColumnDefinitions="190,150,95,115,110,75,75,75,75,75,95" ColumnSpacing="10">
                      <TextBlock Text="Projeto" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="Data" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Text="Duração" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="4" Text="Trivy" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="5" Text="Críticas" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="6" Text="Altas" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="7" Text="Médias" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="8" Text="Baixas" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="9" Text="Novas" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="10" Text="Resolvidas" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Scans}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}">
                          <Grid ColumnDefinitions="190,150,95,115,110,75,75,75,75,75,95" ColumnSpacing="10">
                            <TextBlock Text="{Binding ProjectName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProjectName}" />
                            <TextBlock Grid.Column="1" Text="{Binding Date}" />
                            <TextBlock Grid.Column="2" Text="{Binding Duration}" />
                            <TextBlock Grid.Column="3" Text="{Binding Status}" />
                            <TextBlock Grid.Column="4" Text="{Binding TrivyVersion}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TrivyVersion}" />
                            <TextBlock Grid.Column="5" Text="{Binding Critical}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="6" Text="{Binding High}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="7" Text="{Binding Medium}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="8" Text="{Binding Low}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="9" Text="{Binding New}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="10" Text="{Binding Resolved}" HorizontalAlignment="Right" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="Configurações">
          <ScrollViewer Margin="0,8,0,0">
            <StackPanel Spacing="14" MaxWidth="760">
              <StackPanel Spacing="3">
                <TextBlock Text="Configurações" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Ajuste tecnologia, package manager, armazenamento, comandos do projeto e preferências gerais usadas nos próximos scans." Opacity="0.74" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Text="Projeto" FontSize="18" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding TechnologyOptions}" SelectedItem="{Binding SelectedProject.Project.Technology}" />
              <ComboBox ItemsSource="{Binding PackageManagerOptions}" SelectedItem="{Binding SelectedProject.Project.PackageManager}" />
              <CheckBox Content="Armazenar dentro do projeto (.security/trivy)" IsChecked="{Binding UseInsideProjectStorage}" />
              <ItemsControl ItemsSource="{Binding Commands}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,1.2*,1.4*,2*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                      <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Text="{Binding Name}" />
                      <TextBox Grid.Column="2" Text="{Binding Command}" />
                      <TextBox Grid.Column="3" Text="{Binding Arguments}" />
                      <NumericUpDown Grid.Column="4" Value="{Binding ExecutionOrder}" Minimum="1" Maximum="99" Width="80" />
                      <CheckBox Grid.Column="5" Content="Continuar" IsChecked="{Binding ContinueOnError}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Salvar projeto" Command="{Binding SaveProjectSettingsCommand}" />
                <Button Content="Adicionar ao .gitignore" Command="{Binding AddGitIgnoreEntriesCommand}" />
              </StackPanel>

              <TextBlock Text="Aplicação" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
              <TextBox PlaceholderText="Caminho do Trivy" Text="{Binding Settings.TrivyPath}" />
              <CheckBox Content="Instalar o Trivy automaticamente quando necessário" IsChecked="{Binding Settings.AutoInstallTrivy}" />
              <CheckBox Content="Verificar atualização do Trivy ao abrir" IsChecked="{Binding Settings.AutoUpdateTrivyOnStartup}" />
              <NumericUpDown Value="{Binding Settings.DefaultTimeoutSeconds}" Minimum="30" Maximum="7200" />
              <TextBox PlaceholderText="Diretório de armazenamento" Text="{Binding Settings.StorageDirectory}" />
              <TextBox PlaceholderText="Scanners padrão" Text="{Binding Settings.Scanners}" />
              <TextBox PlaceholderText="Severidades padrão" Text="{Binding Settings.Severities}" />
              <CheckBox Content="Ignorar vulnerabilidades sem correção" IsChecked="{Binding Settings.IgnoreUnfixed}" />
              <CheckBox Content="Habilitar enriquecimento externo de CVE/GHSA" IsChecked="{Binding Settings.EnableVulnerabilityEnrichment}" />
              <CheckBox Content="Usar NVD para CVEs" IsChecked="{Binding Settings.EnableNvdEnrichment}" />
              <CheckBox Content="Usar OSV para identificadores públicos" IsChecked="{Binding Settings.EnableOsvEnrichment}" />
              <CheckBox Content="Usar GitHub Advisory com token" IsChecked="{Binding Settings.EnableGitHubAdvisoryEnrichment}" />
              <TextBox PlaceholderText="GitHub Advisory token" Text="{Binding Settings.GitHubAdvisoryToken}" />
              <TextBox PlaceholderText="Tema: Light, Dark ou System" Text="{Binding Settings.Theme}" />
              <NumericUpDown Value="{Binding Settings.MaxHistoryPerProject}" Minimum="1" Maximum="1000" />

              <TextBlock Text="Atualizações" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
              <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                <TextBlock Text="Versão instalada" Opacity="0.74" />
                <TextBlock Grid.Column="1" Text="{Binding ApplicationInstalledVersion}" />
                <TextBlock Grid.Row="1" Text="Última verificação" Opacity="0.74" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastApplicationUpdateCheckText}" />
                <TextBlock Grid.Row="2" Text="Status" Opacity="0.74" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ApplicationUpdateStatusText}" />
                <TextBlock Grid.Row="3" Text="Canal" Opacity="0.74" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ApplicationUpdateChannelText}" />
              </Grid>
              <Button Content="Verificar agora"
                      Command="{Binding CheckApplicationUpdateCommand}"
                      IsEnabled="{Binding CanCheckApplicationUpdate}"
                      HorizontalAlignment="Left" />

              <Button Content="Salvar configurações" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Logs">
          <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
            <StackPanel Spacing="3">
              <TextBlock Text="Logs" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="Mostra a saída em tempo real dos comandos e do Trivy durante a execução do scan." Opacity="0.74" TextWrapping="Wrap" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
              <ItemsControl ItemsSource="{Binding Logs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Consolas" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </TabItem>

<TabItem Header="Sobre">
    <ScrollViewer Margin="0,8,0,0">
        <StackPanel Spacing="12"
                    MaxWidth="840"
                    HorizontalAlignment="Center">

            <!-- Logo -->
            <Image Source="/Assets/app-logo.png"
                   Height="240"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,16" />

            <!-- Sobre -->
            <TextBlock Text="Sobre"
                       FontSize="22"
                       FontWeight="SemiBold" />

            <TextBlock
                FontSize="16"
                TextWrapping="Wrap"
                TextAlignment="Justify"
                Text="O Package Analyzer é uma ferramenta desktop desenvolvida para auxiliar desenvolvedores e equipes de tecnologia na identificação, análise e gerenciamento de vulnerabilidades em projetos de software." />

            <TextBlock
                FontSize="16"
                TextWrapping="Wrap"
                TextAlignment="Justify"
                Text="A aplicação reúne em uma única interface a execução de análises de segurança, organização dos resultados, histórico de execuções e acompanhamento da evolução das vulnerabilidades, permitindo uma visão clara e prática sobre a saúde dos projetos." />

            <TextBlock
                FontSize="16"
                TextWrapping="Wrap"
                TextAlignment="Justify"
                Text="O objetivo é oferecer uma experiência simples, moderna e totalmente local, facilitando a identificação de bibliotecas vulneráveis, configurações inseguras e outros riscos conhecidos, sem exigir plataformas externas ou processos complexos." />

            <TextBlock
                FontSize="16"
                TextWrapping="Wrap"
                TextAlignment="Justify"
                Text="O Package Analyzer é um projeto independente desenvolvido e mantido por YuriAPCarvalho." />

            <!-- Privacidade -->
            <TextBlock Text="Privacidade"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,18,0,0" />

            <TextBlock
                FontSize="16"
                TextWrapping="Wrap"
                TextAlignment="Justify"
                Text="O Package Analyzer foi desenvolvido seguindo o conceito Local First. Todas as análises são executadas localmente e a aplicação não envia automaticamente código-fonte, projetos, relatórios, nomes de arquivos ou caminhos locais para serviços externos." />

            <TextBlock
                FontSize="16"
                TextWrapping="Wrap"
                TextAlignment="Justify"
                Text="As informações geradas durante as análises permanecem armazenadas apenas no computador do usuário, permitindo total controle sobre os dados processados." />

            <TextBlock
                FontSize="16"
                TextWrapping="Wrap"
                TextAlignment="Justify"
                Text="Quando necessário, a aplicação pode acessar a internet apenas para verificar atualizações do próprio aplicativo e dos componentes utilizados na análise de vulnerabilidades. Nenhum conteúdo dos projetos analisados é transmitido durante esse processo." />

            <TextBlock
                FontSize="16"
                TextWrapping="Wrap"
                TextAlignment="Justify"
                Text="Links para documentações e referências de vulnerabilidades são abertos somente mediante ação explícita do usuário." />

            <Separator Margin="0,12,0,0"/>

            <TextBlock
                HorizontalAlignment="Center"
                FontSize="13"
                Opacity="0.70"
                Text="{Binding ApplicationInstalledVersion, StringFormat='Versão: {0}'}" />

        </StackPanel>
    </ScrollViewer>
</TabItem>
      </TabControl>
    </Grid>
    <StackPanel Grid.ColumnSpan="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,18,10"
                Opacity="0.74">
      <TextBlock Text="Desenvolvido por "
                 FontSize="12"
                 VerticalAlignment="Center" />
      <Button Content="YuriAPCarvalho"
              Command="{Binding OpenReferenceCommand}"
              CommandParameter="https://github.com/YuriAPCarvalho"
              Background="Transparent"
              BorderThickness="0"
              Padding="0"
              FontSize="12"
              Foreground="#45B7FF"
              VerticalAlignment="Center" />
      <TextBlock Text=" © 2026"
                 FontSize="12"
                 VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
